import json, hashlib, sys


def load_json(path):
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)


def sha256_of_text(text: str) -> str:
    return hashlib.sha256(text.encode('utf-8')).hexdigest()


def generate_hash(path):
    data = open(path, 'r', encoding='utf-8').read()
    digest = sha256_of_text(data)
    print(f"SHA256({path}) = {digest}\n")


def summarize(path):
    data = load_json(path)
    print("=== Bridge Protocol Summary ===")
    print(f"Title: {data.get('title')}")
    print(f"Version: {data.get('version')}")
    print(f"Architect: {data['handshake'].get('architect')}")
    print(f"Mission Objectives: {len(data['mission']['objectives'])} items")
    print(f"Ethics Block: ZCP={data['ethics']['zero_collateral_protocol']}  CM={data['ethics']['compassion_metric']}")
    print("===============================\n")


if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: python bridge_protocol.py <bridge_protocol.json>")
        sys.exit(1)
    path = sys.argv[1]
    generate_hash(path)
    summarize(path)
